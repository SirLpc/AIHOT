{
  "$comment": "已核验公开信源；首次导入，无生产数据。采集总开关默认关闭。来源与许可见 docs/SOURCES.md。",
  "sources": [
    {
      "id": "unity-lts-releases",
      "name": "Unity 国际版 LTS releases",
      "kind": "rss",
      "config": {
        "feedUrl": "https://unity.com/releases/editor/lts-releases.xml",
        "_aihot": {
          "initialBackfillLimit": 6
        }
      },
      "tier": "T1",
      "owner_entity_id": "unity-technologies",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [
        "官方",
        "engine:unity_global"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
