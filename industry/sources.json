    {
      "id": "github-com-unity-netcode-gameobjects",
      "name": "Unity Netcode for GameObjects releases",
      "kind": "json_list",
      "config": {
        "url": "https://api.github.com/repos/Unity-Technologies/com.unity.netcode.gameobjects/releases?per_page=10",
        "headers": {
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2022-11-28"
        },
        "titlePaths": [
          "name",
          "tag_name"
        ],
        "summaryPaths": [
          "body"
        ],
        "summaryIsBody": true,
        "urlTemplate": "{raw:html_url}",
        "publishedAtPath": "published_at",
        "updatedAtPath": "updated_at",
        "externalIdPath": "id",
        "requireBoolean": {
          "path": "draft",
          "equals": false
        },
        "_aihot": {
          "initialBackfillLimit": 6
        }
      },
      "tier": "T1",
      "owner_entity_id": "unity-technologies",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [
        "官方",
        "engine:unity_global"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
