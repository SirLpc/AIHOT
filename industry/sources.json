      "id": "tuanjie-releases",
      "name": "团结引擎官方版本",
      "kind": "json_list",
      "config": {
        "url": "https://unity.cn/tuanjie/releases",
        "mode": "html_window_var",
        "windowVar": "__props__",
        "itemsPath": "data.tuanjieRelease.releases",
        "adapter": "tuanjie_releases",
        "sortByPublishedAt": true,
        "detail": {
          "adapter": "tuanjie_release",
          "maxFetches": 6
        },
        "allowUrlPrefixes": [
          "https://unity.cn/editor"
        ],
        "_aihot": {
          "initialBackfillLimit": 6
        }
      },
      "tier": "T1",
      "owner_entity_id": "unity-china",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [
        "官方",
        "engine:tuanjie"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "catlike-coding",
      "name": "Catlike Coding Unity tutorials",
      "kind": "rss",
      "config": {
        "feedUrl": "https://catlikecoding.com/unity/tutorials/feed.atom",
